# ICH — environment variables for the api/ functions (Vercel project settings)
#
# NAMES AND DESCRIPTIONS ONLY. Every value below is a placeholder. Nothing in this file is a
# real credential, and nothing real may ever be committed to it: the browser is served
# index.html, css/ and js/ straight from the repository, and `node test/security/no-secrets.js`
# fails the build if a secret turns up in any of them.
#
# Copy the names into Vercel -> your API project -> Settings -> Environment Variables, then
# redeploy. GET /api/health reports which of these are set (as booleans, never values), and the
# Diagnostics section of the owner control center shows that report inside ICH.
#
# Nothing here belongs in js/core/config.js. config.js is downloaded by every visitor.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — without this every database-touching endpoint is deployed but inert
# ─────────────────────────────────────────────────────────────────────────────

# The Firebase service account, as one line of JSON.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# This is the single most sensitive value in the project: it bypasses every database rule.
# Never put it in a file in this repository, and never log it.
FIREBASE_SA={"type":"service_account","project_id":"example","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n","client_email":"example@example.iam.gserviceaccount.com"}

# Realtime Database URL. Optional — defaults to the project's own in api/_lib.js.
FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com

# The public Firebase Web API key. Not a secret (it is in the page already); here so the
# username-login endpoint can be pointed at a different project without a code change.
FIREBASE_API_KEY=your-public-web-api-key

# ─────────────────────────────────────────────────────────────────────────────
# BUILD GATE — stops stale tabs and hand-edited build labels
# ─────────────────────────────────────────────────────────────────────────────

# A long random string. The SAME value must be passed to tools/stamp-build.js when stamping a
# release: the build-token meta tag is HMAC(BUILD_SECRET, build-label), and api/_lib.js checks
# the pair. Rotating this invalidates every already-stamped build, so re-stamp and redeploy
# together.
BUILD_SECRET=generate-a-long-random-string

# The oldest build label still accepted, e.g. 2026-11-12.01. Anything older is refused and the
# tab is told to reload. Set it to whatever tools/stamp-build.js just printed.
MIN_BUILD=

# Keep equal to CFG.TOS_VERSION in js/core/config.js, or everybody is re-shown the rules.
TOS_VERSION=6

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — each feature is simply off until its variables are set
# ─────────────────────────────────────────────────────────────────────────────

# NSFW image scanning (api/nsfw.js), via Nyckel. With these unset, scanning reports itself as
# unconfigured — it never silently reports "clean", because claiming an unscanned image was
# scanned is worse than saying scanning is off.
NYCKEL_CLIENT_ID=
NYCKEL_CLIENT_SECRET=
NYCKEL_FUNCTION_ID=
# How sure the classifier has to be before an image is refused, 0-1. Unset uses the code default.
NSFW_MIN_CONFIDENCE=

# Where moderation notices are mirrored (api/tos.js). The webhook URL is a bearer credential:
# anyone holding it can post to that channel. It lives here and nowhere else — it used to be in
# js/core/config.js, which is why the deployment notes in package.json still say to rotate it.
DISCORD_WEBHOOK_URL=

# IP MODERATION (api/ipcheck.js, api/ipban.js).
# IP_HASH_SALT is REQUIRED for any IP feature: addresses are never stored, only an HMAC of them,
# and without a salt /api/ipcheck answers 503 "unconfigured" rather than guessing. At least 16
# characters. Changing it invalidates every existing IP ban, because the hashes no longer match.
IP_HASH_SALT=generate-a-long-random-string

# VPN / proxy / Tor detection, via ipapi.is. Unset = no VPN checking (and that is reported as
# unconfigured, never as "checked and clean").
VPN_API_KEY=

# Set to 1 to refuse a request when the VPN lookup itself fails, rather than letting it through.
VPN_FAIL_CLOSED=
# Set to 1 to treat datacenter IPs as proxies.
BLOCK_DATACENTER=

# Agora voice. The APP ID is public and belongs in js/core/config.js as CFG.APP_ID.
# The APP CERTIFICATE must never appear in any browser-served file. Set both here only if you
# want token-authenticated voice; with the certificate unset, the Agora project must have its
# certificate disabled or joining will fail.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT IP RESOLUTION — only touch these if you know your hosting
# ─────────────────────────────────────────────────────────────────────────────

# Which header carries the real client IP, if your platform uses a non-standard one. Leave unset
# on Vercel. Setting this WRONG lets a caller spoof their own address, so leave it alone unless
# you are certain the header is set by your edge and cannot be supplied by the client.
TRUSTED_IP_HEADER=

# Set to 1 to trust the raw socket address instead of a proxy header. Correct only when nothing
# sits in front of the function.
TRUST_SOCKET_IP=

# ─────────────────────────────────────────────────────────────────────────────
# NOT ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary upload settings are an UNSIGNED preset configured in js/core/config.js, because the
# browser uploads directly. Only the cloud name and the unsigned preset name go there — never
# the API secret, which would let anyone delete the whole media library. If you need signed
# uploads, that is a new api/ function and a new variable here.
